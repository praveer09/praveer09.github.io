{
	"name": "praveer-musings",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@11.5.1",
	"scripts": {
		"dev": "astro dev",
		"gen:redirects": "node scripts/gen-redirects.mjs",
		"gen:stubs": "node scripts/gen-redirect-stubs.mjs",
		"prebuild": "node scripts/gen-redirects.mjs && node scripts/gen-redirect-stubs.mjs",
		"build": "astro build",
		"postbuild": "node scripts/fix-mermaid-br.mjs && node scripts/verify-redirects.mjs && node scripts/verify-diagrams.mjs",
		"verify:redirects": "node scripts/verify-redirects.mjs",
		"verify:live": "node scripts/verify-live-redirects.mjs",
		"preview": "astro preview",
		"astro": "astro",
		"typecheck": "astro check",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.2.4",
		"@astrojs/mdx": "^7.0.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"astro": "^7.2.9",
		"sharp": "^0.35.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@beoe/rehype-mermaid": "^0.4.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"eslint": "^10.9.1",
		"eslint-plugin-astro": "^3.1.0",
		"gray-matter": "^4.0.3",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0"
	}
}
